// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FailedEventStatus {
  FAILED
  REPLAY_PENDING
  REPLAYED
  REPLAY_FAILED
}

enum UserRole {
  ADMIN
  VIEWER
}

enum ReplayLogStatus {
  SUCCEEDED
  FAILED
  REQUESTED
  SKIPPED_ALREADY_PROCESSED
}

model Order {
  id               String   @id @default(cuid())
  orderNumber      String   @unique
  tenantId         String
  amount           Decimal  @db.Decimal(10, 2)
  currency         String   @default("INR")
  status           String   @default("CREATED")
  inventoryStatus  String   @default("PENDING")
  paymentStatus    String   @default("PENDING")
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
  @@map("orders")
}

model FailedEvent {
  id                 String            @id @default(cuid())
  eventId            String            @unique
  eventType          String
  tenantId           String
  streamName         String
  orderId            String?
  originalPayload    Json
  errorMessage       String
  retryCount         Int               @default(0)
  status             FailedEventStatus @default(FAILED)
  firstFailedAt      DateTime
  lastFailedAt       DateTime
  replayedAt         DateTime?
  replayRequestedBy  String?
  replayMetadata     Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  replayLogs         ReplayLog[]

  @@index([status])
  @@index([tenantId])
  @@index([orderId])
  @@index([eventType])
  @@map("failed_events")
}

model ProcessedEvent {
  id              String   @id @default(cuid())
  eventId         String   @unique
  eventType       String
  tenantId        String
  orderId         String?
  sourceStream    String
  replayed        Boolean  @default(false)
  processedAt     DateTime @default(now())
  processor       String
  checksum        String?
  metadata        Json?

  @@index([tenantId])
  @@index([orderId])
  @@index([eventType])
  @@map("processed_events")
}

model ReplayLog {
  id              String          @id @default(cuid())
  failedEventId   String
  eventId         String
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  status          ReplayLogStatus @default(REQUESTED)
  requestPayload  Json?
  resultPayload   Json?
  errorMessage    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  failedEvent     FailedEvent     @relation(fields: [failedEventId], references: [id], onDelete: Cascade)

  @@index([failedEventId])
  @@index([eventId])
  @@index([userId])
  @@map("replay_logs")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(ADMIN)
  accounts      Account[]
  sessions      Session[]
  replayLogs    ReplayLog[]

  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}